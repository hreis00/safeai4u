## Best Practices

### 1. Use Type-Only Imports
```typescript
import type { ComponentProps } from 'react';
import type { BaseComponentProps } from '@/lib/types';
```

### 2. Leverage Type Inference
```typescript
// Good - TypeScript infers the type
const items = ['apple', 'banana', 'orange']; // string[]

// Good - Explicit when needed for clarity
const items: string[] = ['apple', 'banana', 'orange'];
```

### 3. Use Generic Types for Reusability
```typescript
interface ApiResponse<T> {
  data: T;
  status: number;
  message: string;
}

// Usage
type UserResponse = ApiResponse<User>;
type ProductResponse = ApiResponse<Product>;
```

### 4. Handle Null and Undefined Explicitly
```typescript
// Good - Explicit null handling
function processUser(user: User | null): string {
  if (!user) {
    return 'No user';
  }
  return user.name;
}

// Good - Optional chaining
function processUser(user?: User): string {
  return user?.name ?? 'No user';
}
```

### 5. Use Discriminated Unions
```typescript
type LoadingState = { status: 'loading' };
type SuccessState = { status: 'success'; data: User[] };
type ErrorState = { status: 'error'; error: string };

type State = LoadingState | SuccessState | ErrorState;

function handleState(state: State) {
  switch (state.status) {
    case 'loading':
      return <LoadingSpinner />;
    case 'success':
      return <UserList users={state.data} />;
    case 'error':
      return <ErrorMessage message={state.error} />;
  }
}
```

## Performance Considerations

### 1. Use React.memo with Proper Types
```typescript
interface ExpensiveComponentProps {
  data: ComplexData;
  onUpdate: (id: string) => void;
}

export const ExpensiveComponent = React.memo<ExpensiveComponentProps>(
  ({ data, onUpdate }) => {
    // Component implementation
  }
);
```

### 2. Use useCallback with Proper Dependencies
```typescript
export function Component({ data, onUpdate }: ComponentProps) {
  const handleUpdate = useCallback((id: string) => {
    onUpdate(id);
  }, [onUpdate]);

  return <div onClick={() => handleUpdate(data.id)}>{data.name}</div>;
}
```

This TypeScript pattern system ensures type safety, maintainability, and developer experience throughout the application.