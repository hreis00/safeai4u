### Type Guards
```typescript
// Runtime type checking
export const isString = (value: unknown): value is string => typeof value === 'string';
export const isNumber = (value: unknown): value is number => typeof value === 'number' && !isNaN(value);
export const isBoolean = (value: unknown): value is boolean => typeof value === 'boolean';
export const isObject = (value: unknown): value is Record<string, unknown> => 
  value !== null && typeof value === 'object' && !Array.isArray(value);
export const isArray = <T>(value: unknown): value is T[] => Array.isArray(value);

// Validation type guards
export const isEmail = (value: string): boolean => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
export const isUrl = (value: string): boolean => {
  try { new URL(value); return true; } catch { return false; }
};
```

## Component Type Patterns

### Server Components (Preferred)
```typescript
// No "use client" directive
import type { BaseComponentProps } from '@/lib/types';

interface ServerComponentProps extends BaseComponentProps {
  data: string;
  onAction?: (id: string) => void;
}

export function ServerComponent({ data, className, onAction }: ServerComponentProps) {
  return (
    <div className={className}>
      <Button onClick={() => onAction?.(data)}>{data}</Button>
    </div>
  );
}
```

### Client Components (When Needed)
```typescript
"use client";

import { useState } from 'react';
import type { InteractiveComponentProps } from '@/lib/types';

interface ClientComponentProps extends InteractiveComponentProps {
  initialValue: string;
  onSubmit?: (value: string) => void;
}

export function ClientComponent({ 
  initialValue, 
  className, 
  disabled = false,
  onSubmit 
}: ClientComponentProps) {
  const [value, setValue] = useState(initialValue);
  
  const handleSubmit = () => {
    onSubmit?.(value);
  };
  
  return (
    <div className={className}>
      <Button disabled={disabled} onClick={handleSubmit}>
        {value}
      </Button>
    </div>
  );
}
```

### Hybrid Component Architecture
```typescript
// Server component for static content
export function ServiceTabs({ services }: { services: Service[] }) {
  return (
    <div className="space-y-4">
      {services.map((service) => (
        <ServiceCard key={service.id} service={service} />
      ))}
    </div>
  );
}

// Client component for interactions
"use client";
export function ServiceTabsInteractive({ 
  onTabChange 
}: { 
  onTabChange: (tabId: string) => void 
}) {
  const [activeTab, setActiveTab] = useState<string>('');
  
  return (
    <Tabs value={activeTab} onValueChange={setActiveTab}>
      {/* Tab implementation */}
    </Tabs>
  );
}
```

## Form Type Patterns

### Zod Schema Integration
```typescript
import { z } from 'zod';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import type { FormValidationResult } from '@/lib/types';

const formSchema = z.object({
  name: z.string().min(2, "Name must be at least 2 characters"),
  email: z.string().email("Invalid email address"),
  age: z.number().min(18, "Must be at least 18 years old"),
  newsletter: z.boolean(),
  consultation: z.boolean(),
});

type FormData = z.infer<typeof formSchema>;

interface FormProps extends BaseComponentProps {
  onSubmit?: (data: FormData) => Promise<void>;
  onValidationChange?: (result: FormValidationResult) => void;
}

export function MyForm({ onSubmit, onValidationChange, className }: FormProps) {
  const form = useForm<FormData>({
    resolver: zodResolver(formSchema),
    defaultValues: {
      name: '',
      email: '',
      age: 18,
      newsletter: false,
      consultation: false,
    },
  });

  const handleSubmit = async (data: FormData) => {
    try {
      await onSubmit?.(data);
    } catch (error) {
      // Error handling
    }
  };

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(handleSubmit)} className={className}>
        {/* Form fields */}
      </form>
    </Form>
  );
}
```

