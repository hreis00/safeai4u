## Component Patterns

### Server Components (Preferred)

```typescript
// No "use client" directive
import type { BaseComponentProps } from "@/lib/types";

interface ComponentProps extends BaseComponentProps {
  title: string;
}

export function Component({ title, className }: ComponentProps) {
  return (
    <div className={className}>
      <h2>{title}</h2>
    </div>
  );
}
```

### Client Components (When Needed)

```typescript
"use client";

import { useState } from "react";
import type { InteractiveComponentProps } from "@/lib/types";

interface ComponentProps extends InteractiveComponentProps {
  initialValue: string;
}

export function Component({ initialValue, disabled }: ComponentProps) {
  const [value, setValue] = useState(initialValue);

  return (
    <button disabled={disabled} onClick={() => setValue("new")}>
      {value}
    </button>
  );
}
```

## Form Components

```typescript
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";

const formSchema = z.object({
  name: z.string().min(2, "Name must be at least 2 characters"),
  email: z.string().email("Invalid email address"),
});

type FormData = z.infer<typeof formSchema>;

export function FormComponent() {
  const form = useForm<FormData>({
    resolver: zodResolver(formSchema),
    defaultValues: { name: '', email: '' },
  });

  const handleSubmit = async (data: FormData) => {
    // Handle submission
  };

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(handleSubmit)}>
        {/* Form fields */}
      </form>
    </Form>
  );
}
```

## Best Practices

### ✅ DO

- Use existing reusable components for new sections
- Maintain consistent spacing and typography
- Centralize all content in data files under `src/lib/content/`
- Use standardized classes from `globals.css` (`.bg-section-muted`, etc.)
- Use semantic HTML with proper heading hierarchy
- Add `mb-16` to the last section on a page for footer spacing

### ❌ DON'T

- Create custom section layouts when a reusable component exists
- Use inline opacity modifiers (`bg-muted/50`, `border-primary/20`)
- Hardcode content in components - always use data files
- Mix different spacing patterns
- Skip animations on new sections
