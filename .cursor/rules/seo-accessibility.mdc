## Accessibility Standards

### Semantic HTML
Always use semantic HTML elements:

```tsx
<main>
  <header>
    <nav aria-label="Main navigation">
      {/* Navigation content */}
    </nav>
  </header>
  
  <section aria-labelledby="hero-heading">
    <h1 id="hero-heading">Page Title</h1>
    <p>Page description</p>
  </section>
  
  <footer>
    {/* Footer content */}
  </footer>
</main>
```

### ARIA Labels and Descriptions
```tsx
<Button 
  aria-label="Contact us for AI consulting services"
  aria-describedby="contact-description"
>
  Contact Us
</Button>
<div id="contact-description" className="sr-only">
  Get in touch to discuss your AI project requirements
</div>
```

### Form Accessibility
```tsx
<form onSubmit={handleSubmit}>
  <div className="space-y-4">
    <div>
      <Label htmlFor="name">Full Name</Label>
      <Input
        id="name"
        type="text"
        aria-required="true"
        aria-describedby="name-error"
        {...register("name")}
      />
      {errors.name && (
        <p id="name-error" className="text-destructive text-sm mt-1">
          {errors.name.message}
        </p>
      )}
    </div>
  </div>
</form>
```

### Color Contrast
The cyberpunk theme maintains WCAG AA contrast ratios:
- Light mode: High contrast backgrounds with dark text
- Dark mode: Dark backgrounds with light text
- Accent colors: Sufficient contrast for interactive elements

### Keyboard Navigation
Ensure all interactive elements are keyboard accessible:

```tsx
<Button
  onKeyDown={(e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      handleClick();
    }
  }}
  tabIndex={0}
>
  Interactive Element
</Button>
```

### Focus Management
```tsx
import { useEffect, useRef } from "react";

function Modal({ isOpen, onClose }: ModalProps) {
  const focusRef = useRef<HTMLButtonElement>(null);
  
  useEffect(() => {
    if (isOpen && focusRef.current) {
      focusRef.current.focus();
    }
  }, [isOpen]);
  
  return (
    <div role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <button ref={focusRef} onClick={onClose}>
        Close
      </button>
    </div>
  );
}
```

